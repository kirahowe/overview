# Atom's One Light, for a light terminal background: the same blue accent
# and quiet status bar as one-dark, in the light palette.
accent        = #4078f2
border        = #c2c2c3
text          = #383a42
muted         = #696c77
cursor-bg     = #4078f2
cursor-dim-bg = #e5e5e6
status-fg     = #383a42
status-bg     = #e5e5e6
pill-fg       = #fafafa
blocked       = #e45649
asking        = #c18401
working       = #50a14f
code          = #0184bc
added           = #50a14f
removed         = #e45649
added-bg        = #e8f5e7
removed-bg      = #fbeaea
added-word-bg   = #c3e6c1
removed-word-bg = #f6c6c4
syntax          = github
