# Atom's One Dark: a blue accent, its muted greys, and a quiet status bar.
accent        = #61afef
border        = #4b5263
text          = #abb2bf
muted         = #7f848e
cursor-bg     = #61afef
cursor-dim-bg = #3e4451
status-fg     = #abb2bf
status-bg     = #3e4451
pill-fg       = #282c34
blocked       = #e06c75
asking        = #e5c07b
working       = #98c379
code          = #56b6c2
added           = #98c379
removed         = #e06c75
added-bg        = #283b2b
removed-bg      = #3f2a2e
added-word-bg   = #3e5e40
removed-word-bg = #6b363d
syntax          = onedark
