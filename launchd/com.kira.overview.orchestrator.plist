<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kira.overview.orchestrator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/kira/.local/bin/overview</string>
    <string>orchestrator</string>
    <string>ensure</string>
    <string>--home</string>
    <string>kira</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/kira/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/kira</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <!-- A restart leaves a background session behind; without this launchd would kill it. -->
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/kira/Library/Logs/overview/orchestrator.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kira/Library/Logs/overview/orchestrator.log</string>
</dict>
</plist>
