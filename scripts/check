#!/usr/bin/env bash
# The gate every change must pass before it is committed.
#   scripts/check              full gate
#   scripts/check --deep [n]   also rerun property tests with n cases each
#                              (2000 by default)
set -euo pipefail
cd "$(dirname "$0")/.."

checks=""
case "${1:-}" in
  "") ;;
  --deep) checks=${2:-2000} ;;
  *) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
step() { printf '\n==> %s\n' "$*"; }

step "gofmt"
unformatted=$(gofmt -l .)
if [[ -n "$unformatted" ]]; then
  printf 'not gofmt-clean (run gofmt -w):\n%s\n' "$unformatted" >&2
  exit 1
fi

step "go vet"
go vet ./...
# The end-to-end test builds only with its tag; scripts/e2e runs it.
go vet -tags e2e ./e2e

step "staticcheck"
staticcheck=$(command -v staticcheck || true)
if [[ -z "$staticcheck" && -x "$HOME/go/bin/staticcheck" ]]; then
  staticcheck="$HOME/go/bin/staticcheck"
fi
if [[ -n "$staticcheck" ]]; then
  "$staticcheck" ./...
else
  echo "skipped: staticcheck not installed (go install honnef.co/go/tools/cmd/staticcheck@latest)"
fi

step "go test -race"
go test -race -count=1 ./...
if [[ -n "$checks" ]]; then
  # Only packages that import rapid accept -rapid.checks.
  pkgs=$(grep -rl --include='*_test.go' 'pgregory.net/rapid' . | xargs -n1 dirname | sort -u)
  step "property tests, $checks cases"
  # shellcheck disable=SC2086
  go test -race -count=1 $pkgs -rapid.checks="$checks"
fi

step "go build"
go build -o bin/overview .

echo; echo "check: ok"
