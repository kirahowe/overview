#!/bin/bash
# e2e-ghostty: opt-in end-to-end test of overview's jump, in real Ghostty.
#
# Needs stock Ghostty 1.3+ with its AppleScript interface, running, and
# macOS Automation permission for the calling terminal. It is NOT part of
# scripts/check: it opens windows on the live desktop and moves focus.
#
#   OVERVIEW_E2E=1 scripts/e2e-ghostty
#
# What it does:
#   * builds bin/overview, makes a temp home and a fake `claude` (selected with
#     OVERVIEW_CLAUDE) whose `agents --json` lists a background session and two
#     interactive ones. One interactive session's pid is a `sleep` running in
#     Ghostty window B, so its tty is B's.
#   * opens window A running overview against that fake world, drives it with
#     Ghostty's `input text` / `send key`, and asserts that the focused
#     terminal of Ghostty's front window becomes B's terminal.
#   * scenarios: jump via `/filter` + Enter; jump with no filter on the
#     selected row; a stale jump after B is closed (overview must survive and
#     stay put).
#
# Only windows this script opens are touched; all are closed, and every
# process it started is killed by pid, on exit (trap) even after a failure.
# It never reads or writes the real ~/.claude-* or Ghostty's config.
# Exit status: 0 all passed, 1 an assertion failed, 2 setup problem.
set -u

[ "${OVERVIEW_E2E:-}" = 1 ] || { echo "e2e-ghostty is opt-in: set OVERVIEW_E2E=1" >&2; exit 2; }
repo=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/ov-e2e.XXXXXX")
windows=() pids=() fails=0
now() { perl -MTime::HiRes=time -e 'printf "%.0f\n", time*1000'; }

cleanup() {
  local w p
  for w in "${windows[@]:-}"; do
    [ -n "$w" ] && osascript -e "tell application \"Ghostty\" to close window (window id \"$w\")" >/dev/null 2>&1
  done
  for p in "${pids[@]:-}"; do [ -n "$p" ] && kill "$p" 2>/dev/null; done
  if [ -n "${a_pid:-}" ]; then kill "$a_pid" 2>/dev/null; fi
  rm -rf "$tmp"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

pass() { echo "PASS  $*"; }
fail() { echo "FAIL  $*"; fails=$((fails+1)); }
die() { echo "setup: $*" >&2; exit 2; }

osascript -l JavaScript -e 'Application("Ghostty").running()' 2>/dev/null | grep -q true || die "Ghostty is not running"
(cd "$repo" && go build -o bin/overview .) || die "build failed"

# --- fake world ---------------------------------------------------------
home=$tmp/home; mkdir -p "$home"
for d in a-target b-other c-bg; do mkdir -p "$tmp/$d/.git"; done
cat > "$tmp/claude" <<'SH'
#!/bin/sh
[ "$1" = agents ] && exec cat "$E2E_LIVE"
exit 0
SH
chmod +x "$tmp/claude"
live=$tmp/live.json; echo '[]' > "$live"

# Starts a command in a new Ghostty window; prints "window-id terminal-id".
open_window() {
  osascript - "$1" <<'AS'
on run argv
  tell application "Ghostty"
    set cfg to new surface configuration from {command:item 1 of argv}
    set w to new window with configuration cfg
    return (id of w) & " " & (id of focused terminal of selected tab of w)
  end tell
end run
AS
}
# osascript JXA helpers
jxa() { osascript -l JavaScript -e "$1" "${@:2}" 2>&1; }
front_terminal() {
  osascript -e 'tell application "Ghostty" to return id of focused terminal of selected tab of front window'; }
focus_term() { osascript -e "tell application \"Ghostty\" to focus (terminal id \"$1\")" >/dev/null
  [ "$(front_terminal)" = "$1" ] || { sleep 0.3; [ "$(front_terminal)" = "$1" ] || die "could not focus $1 first"; }; }
all_terms() { osascript -e 'tell application "Ghostty" to return id of every terminal'; }
send_text() { osascript -e "tell application \"Ghostty\" to input text \"$2\" to (terminal id \"$1\")" >/dev/null; }
send_key() { osascript -e "tell application \"Ghostty\" to send key \"$2\" to (terminal id \"$1\")" >/dev/null; }

# Window B: records its tty and pid, then sits in sleep.
cat > "$tmp/b.sh" <<SH
#!/bin/sh
tty > "$tmp/b.tty"; echo \$\$ > "$tmp/b.pid"; exec sleep 600
SH
chmod +x "$tmp/b.sh"
read -r b_win b_term < <(open_window "$tmp/b.sh") || die "cannot open window B"
windows+=("$b_win")
for _ in $(seq 50); do [ -s "$tmp/b.pid" ] && break; sleep 0.1; done
[ -s "$tmp/b.pid" ] || die "window B never ran its command"
b_pid=$(cat "$tmp/b.pid"); pids+=("$b_pid")
sleep 600 & o_pid=$!; pids+=("$o_pid")   # second interactive session, no Ghostty tty

cat > "$live" <<JSON
[
 {"pid":$b_pid,"id":"","cwd":"$tmp/a-target","kind":"interactive","startedAt":1760000000000,"sessionId":"s-target","name":"ovtarget","status":"idle"},
 {"pid":$o_pid,"id":"","cwd":"$tmp/b-other","kind":"interactive","startedAt":1760000001000,"sessionId":"s-other","name":"ovother","status":"idle"},
 {"pid":999999,"id":"bg01","cwd":"$tmp/c-bg","kind":"background","startedAt":1760000002000,"sessionId":"s-bg","name":"ovbg","status":"idle","state":"idle"}
]
JSON

# Window A: overview itself.
cat > "$tmp/a.sh" <<SH
#!/bin/sh
echo \$\$ > "$tmp/a.pid"
export OVERVIEW_CLAUDE="$tmp/claude" E2E_LIVE="$live"
exec "$repo/bin/overview" --home "$home"
SH
chmod +x "$tmp/a.sh"
start_a() {
  rm -f "$tmp/a.pid"
  read -r a_win a_term < <(open_window "$tmp/a.sh") || die "cannot open window A"
  windows+=("$a_win")
  for _ in $(seq 50); do [ -s "$tmp/a.pid" ] && break; sleep 0.1; done
  a_pid=$(cat "$tmp/a.pid"); sleep 1.5   # first render
}
start_a
echo "A=$a_term B=$b_term (tty $(cat "$tmp/b.tty"))"

alive() { kill -0 "$a_pid" 2>/dev/null; }
# wait_front <terminal id> <ms>: poll until it is the front window's focused terminal.
wait_front() {
  local t0 t; t0=$(now)
  while :; do
    t=$(front_terminal 2>/dev/null)
    if [ "$t" = "$1" ]; then echo $(( $(now) - t0 )); return 0; fi
    [ $(( $(now) - t0 )) -gt "$2" ] && return 1
    sleep 0.1
  done
}
# scenario <name> <expected front terminal> <keys fn>
check_jump() {
  local name=$1 want=$2 ms
  if ms=$(wait_front "$want" 4000); then pass "$name (front after ${ms} ms)"; else fail "$name: front is $(front_terminal), wanted $want"; fi
}

# 1. /filter + Enter
focus_term "$a_term"; sleep 0.4
send_text "$a_term" "/"; send_text "$a_term" "ovtarget"; sleep 0.3; send_key "$a_term" enter
check_jump "filter+enter jumps to B" "$b_term"
alive && pass "overview alive after jump 1" || fail "overview died after jump 1"
osascript -e "tell application \"Ghostty\" to return name of terminal id \"$b_term\"" | grep -q '^ov-' \
  && fail "B's title still holds the locate token" || pass "B's title restored"

# 2. no filter, selected row (the first row is the target: a-target sorts first)
focus_term "$a_term"; sleep 0.4
send_key "$a_term" enter
check_jump "plain enter on selected row jumps to B (cached id)" "$b_term"

# 3. stale: close B but leave its sleep running, then jump again
osascript -e "tell application \"Ghostty\" to close window (window id \"$b_win\")" >/dev/null 2>&1
windows=("${windows[@]/$b_win}")
sleep 0.8
all_terms | grep -q "$b_term" && fail "B still exists after close" || pass "B closed"
focus_term "$a_term"; sleep 0.4
t0=$(now); send_key "$a_term" enter; sleep 3.5
alive && pass "overview survives stale jump ($(( $(now) - t0 )) ms incl. wait)" || fail "overview died on stale jump"
[ "$(front_terminal)" = "$a_term" ] && pass "focus stayed on A after stale jump" || fail "focus moved on stale jump"

echo; [ "$fails" = 0 ] && echo "all passed" || echo "$fails failed"
[ "$fails" = 0 ]
